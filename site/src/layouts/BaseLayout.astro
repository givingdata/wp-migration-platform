---
import "../styles/global.css";
import { SITE } from "../lib/site";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { buildImageSet } from "../lib/images";
import { THEME, themeCss, googleFontsHref, warnOnce } from "../lib/theme";
import { SITE_CONFIG, analyticsHead, analyticsBody } from "../lib/siteConfig";
import type { Seo } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  /** Social share image (absolute or site-relative URL). */
  image?: string | null;
  imageType?: string;
  ogType?: "website" | "article";
  /** JSON-LD object(s) for this page. */
  structuredData?: object | object[];
  noindex?: boolean;
  /** Per-page SEO overrides (content.json / sections.json "seo"). */
  seo?: Seo | null;
}

const { title, description: pageDescription = SITE.tagline, image, imageType = "post", ogType = "website", structuredData, noindex: pageNoindex = false, seo = null } = Astro.props;
// An SEO title (e.g. imported from Yoast) is used exactly as written; otherwise "Page | Site".
const fullTitle = seo?.title || (title ? `${title} | ${SITE.name}` : SITE.name);
const description = seo?.description || pageDescription;
const noindex = pageNoindex || !!seo?.noindex;
const canonical = seo?.canonical || new URL(Astro.url.pathname, Astro.site).href;
const imageSrc = seo?.image || image;
const shareImage = imageSrc
  ? new URL(buildImageSet(imageSrc, imageType).src, Astro.site).href
  : SITE_CONFIG.shareImage ? new URL(SITE_CONFIG.shareImage, Astro.site).href : undefined;
const tracking = analyticsHead();
const trackingBody = analyticsBody();

const ld = [
  { "@context": "https://schema.org", "@type": "Organization", name: SITE.name, url: Astro.site?.href },
  ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : []),
];

warnOnce();
const fontsHref = googleFontsHref();
const logo = THEME.logo;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content={THEME.darkMode ? "light dark" : "light"} />
    <style is:inline set:html={themeCss()} />
    {fontsHref && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fontsHref && <link rel="stylesheet" href={fontsHref} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={seo?.title || title || SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {SITE_CONFIG.searchConsole && <meta name="google-site-verification" content={SITE_CONFIG.searchConsole} />}
    {tracking && <Fragment set:html={tracking} />}
  </head>
  <body>
    {trackingBody && <Fragment set:html={trackingBody} />}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          {logo && (
            <picture>
              {logo.darkSrc && THEME.darkMode && <source media="(prefers-color-scheme: dark)" srcset={logo.darkSrc} />}
              <img src={logo.src} alt={logo.showName ? "" : SITE.name} height={logo.height ?? 40} style={`height: ${logo.height ?? 40}px`} />
            </picture>
          )}
          {(!logo || logo.showName) && <span>{SITE.name}</span>}
        </a>
        <Nav />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
