---
// Articles (news, announcements, other article-layout types) and static pages
// (pages omit the date/author line).
import BaseLayout from "./BaseLayout.astro";
import Image from "../components/Image.astro";
import { formatDate, fixContentLinks, bodyHtml, excerpt, typeDef, type Entry } from "../lib/content";
import { SITE } from "../lib/site";
import { pageSections, sectionsDescription } from "../lib/sections";
import Sections from "../components/sections/Sections.astro";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const isPage = entry.type === "page";
const url = new URL(Astro.url.pathname, Astro.site).href;
// A page listed in sections.json is built from sections instead of its migrated content.
const built = isPage ? pageSections((entry as { path?: string }).path ?? entry.slug) : null;
const firstIsHero = built?.sections[0]?.type === "hero";
const contentBlock = entry.content ? fixContentLinks(entry.content) : null;

const structuredData = isPage
  ? { "@context": "https://schema.org", "@type": "WebPage", name: entry.title, description: excerpt(entry, 300), url }
  : {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: entry.title,
      description: excerpt(entry, 300),
      datePublished: entry.dateTime || entry.date,
      ...(entry.modified ? { dateModified: entry.modified } : {}),
      ...(entry.image ? { image: entry.image } : {}),
      author: { "@type": entry.author ? "Person" : "Organization", name: entry.author || SITE.name },
      publisher: { "@type": "Organization", name: SITE.name },
      mainEntityOfPage: url,
    };
---

<BaseLayout seo={built?.seo || entry.seo} title={entry.title} description={(built && sectionsDescription(built.sections)) || excerpt(entry)} image={entry.image} imageType={entry.type} ogType={isPage ? "website" : "article"} structuredData={structuredData} sectioned={!!built}>
  {built ? (
    <>
      {!firstIsHero && <h1 class="visually-hidden">{entry.title}</h1>}
      {built.content === "before" && contentBlock && <div class="wrap narrow section"><div class="prose" set:html={contentBlock} /></div>}
      <Sections sections={built.sections} />
      {built.content === "after" && contentBlock && <div class="wrap narrow section"><div class="prose" set:html={contentBlock} /></div>}
    </>
  ) : (
  <article class:list={["entry", isPage ? "entry-page" : "entry-post"]}>
    <div class="wrap narrow">
      {!isPage && <p class="eyebrow">{typeDef(entry.type)?.label ?? "News"}</p>}
      <h1>{entry.title}</h1>
      {!isPage && (
        <p class="meta">
          <time datetime={entry.date ?? undefined}>{formatDate(entry.date)}</time>
          {entry.author && <> · {entry.author}</>}
        </p>
      )}
      {entry.image && (
        <figure class="featured">
          <Image src={entry.image} alt={entry.imageAlt || ""} type={entry.type} variants={entry.imageVariants} priority sizes="(min-width: 46rem) 44rem, 100vw" />
        </figure>
      )}
      <div class="prose" set:html={bodyHtml(entry)} />
      {entry.linkUrl && <p><a class="btn btn-primary" href={entry.linkUrl}>Learn more</a></p>}
      {!isPage && entry.tags && entry.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">{entry.tags.map((t) => <li>{t}</li>)}</ul>
      )}
    </div>
  </article>
  )}
</BaseLayout>
