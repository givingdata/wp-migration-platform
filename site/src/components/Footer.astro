---
// Site footer: text, links and social icons copied from WordPress (content.json "footer").
import * as icons from "simple-icons";
import { SITE } from "../lib/site";
import { getContent, resolveMenuUrl } from "../lib/content";
import { siteSettings } from "../lib/sections";

const { text, menu, social } = getContent().footer;
// Optional richer footer from sections.json: about text, address, contact emails, a note.
const extra = siteSettings().footer;
const links = menu.map((i) => ({ label: i.title, href: resolveMenuUrl(i.url) })).filter((l) => l.href);

const NAMES: Record<string, string> = {
  facebook: "Facebook", instagram: "Instagram", x: "X", linkedin: "LinkedIn", youtube: "YouTube", tiktok: "TikTok",
  pinterest: "Pinterest", threads: "Threads", bluesky: "Bluesky", mastodon: "Mastodon", vimeo: "Vimeo",
};
const socials = social.map((s) => {
  const name = NAMES[s.network] ?? s.network;
  const icon = (icons as Record<string, { path: string } | undefined>)[`si${s.network[0].toUpperCase()}${s.network.slice(1)}`];
  return { name, url: s.url, path: icon?.path ?? null };
});
---

<footer class:list={["site-footer", extra && "footer-rich"]}>
  <div class="wrap">
    {extra && (
      <div class="footer-cols">
        <div class="footer-about">
          <p class="footer-name">{SITE.name}</p>
          {extra.about && <p>{extra.about}</p>}
          {extra.note && <p class="footer-note">{extra.note}</p>}
        </div>
        {!!(extra.address?.length || extra.contacts?.length) && (
          <div>
            <p class="footer-heading">Contact</p>
            {extra.address && <address>{extra.address.map((l, i) => <>{i > 0 && <br />}{l}</>)}</address>}
            {extra.contacts && <ul class="footer-contacts">{extra.contacts.map((c) => <li>{c.label}: <a href={`mailto:${c.email}`}>{c.email}</a></li>)}</ul>}
          </div>
        )}
      </div>
    )}
    {text.map((t) => <p class="footer-text">{t}</p>)}
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} {SITE.name}</p>
      {links.length > 0 && (
        <nav aria-label="Footer">
          <ul class="footer-links">
            {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      )}
      {socials.length > 0 && (
        <ul class="social-links">
          {socials.map((s) => (
            <li>
              <a href={s.url} rel="noopener me" target="_blank" aria-label={s.path ? s.name : undefined}>
                {s.path ? (
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d={s.path} fill="currentColor" /></svg>
                ) : s.name}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</footer>
