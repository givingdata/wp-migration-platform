---
// Hero. "photo" (default): full-width photo behind the text, stats bottom-right.
// "split": text beside a framed photo on the band colour (no overlay on the photo).
// shade "neutral" (photo layout): the photo keeps its colours, darkened only behind the text.
// parallax (photo layout): the photo scrolls more slowly than the text: "subtle", "medium" (default) or "strong"; false = off.
import { parallaxClass, type Hero } from "../../lib/sections";
import Paras from "./Paras.astro";
import Buttons from "./Buttons.astro";
interface Props { s: Hero; first?: boolean }
const { s, first = false } = Astro.props;
const split = s.layout === "split";
const Title = first ? "h1" : "h2";
const parallax = parallaxClass(s.parallax, true);
---
{split ? (
  <section class="s-hero s-hero-split" id={s.id}>
    <div class="wrap s-hero-split-inner">
      <div class="s-hero-main">
        {s.eyebrow && <p class="s-eyebrow">{s.eyebrow}</p>}
        <Title class="s-hero-title">{s.title}{s.accent && <> <em>{s.accent}</em></>}</Title>
        {s.text && <Paras class="s-lede" text={s.text} />}
        <Buttons buttons={s.buttons} />
        {s.stats && s.stats.length > 0 && (
          <dl class="s-hero-facts">
            {s.stats.map((st) => <div><dt>{st.label}</dt><dd>{st.value}</dd></div>)}
          </dl>
        )}
      </div>
      {s.image && (
        <figure class="s-hero-frame">
          <img src={s.image.src} alt={s.image.alt ?? ""} loading={first ? "eager" : "lazy"} fetchpriority={first ? "high" : undefined} decoding="async" />
        </figure>
      )}
    </div>
  </section>
) : (
  <section class:list={["s-hero", s.shade === "neutral" && "s-hero-neutral", parallax]} id={s.id}>
    {s.image && <img class:list={["s-hero-img", parallax && "s-parallax-img"]} src={s.image.src} alt={s.image.alt ?? ""} loading={first ? "eager" : "lazy"} fetchpriority={first ? "high" : undefined} decoding="async" />}
    <div class="s-hero-shade"></div>
    <div class="wrap s-hero-inner">
      <div class="s-hero-main">
        {s.eyebrow && <p class="s-eyebrow">{s.eyebrow}</p>}
        <Title class="s-hero-title">{s.title}{s.accent && <> <em>{s.accent}</em></>}</Title>
        {s.text && <Paras class="s-lede" text={s.text} />}
        <Buttons buttons={s.buttons} />
      </div>
      {s.stats && s.stats.length > 0 && (
        <dl class="s-hero-stats">
          {s.stats.map((st) => <div><dt>{st.label}</dt><dd>{st.value}</dd></div>)}
        </dl>
      )}
    </div>
  </section>
)}
