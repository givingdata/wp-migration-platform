---
// Line icons for "features" sections: 24×24, drawn with the current text colour.
// Names: coffee, croissant, leaf, calendar, music, glass, utensils, heart, sun, users, star,
// gift, cake, map, clock. An unknown or missing name draws nothing.
interface Props { name?: string; size?: number }
const { name, size = 40 } = Astro.props;
const PATHS: Record<string, string> = {
  coffee: "M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9zM17 10h1.5a2.5 2.5 0 0 1 0 5H17M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3M4 21h14",
  croissant: "M3 15c2-6 7-9 9-9s7 3 9 9c-3 1-5 1-6 0l-1-4-2 5-2-5-1 4c-1 1-3 1-6 0z",
  leaf: "M5 19c0-8 5-14 15-15-1 10-7 15-15 15zM5 19l8-8",
  calendar: "M4 6h16v14H4zM4 10h16M8 3v5M16 3v5M8 14h2M14 14h2M8 17h2",
  music: "M9 18V5l11-2v13M9 18a3 3 0 1 1-3-3 3 3 0 0 1 3 3zM20 16a3 3 0 1 1-3-3 3 3 0 0 1 3 3z",
  glass: "M7 3h10l-1 7a4 4 0 0 1-8 0L7 3zM12 14v7M8 21h8M7.5 7h9",
  utensils: "M6 3v7a2 2 0 0 0 4 0V3M8 10v11M17 3c-2 1-3 4-3 7h3v11",
  heart: "M12 20s-8-5-8-11a4.5 4.5 0 0 1 8-2.5A4.5 4.5 0 0 1 20 9c0 6-8 11-8 11z",
  sun: "M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zM12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4",
  users: "M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21v-1a6 6 0 0 1 12 0v1M16 3.5a4 4 0 0 1 0 7.5M22 21v-1a6 6 0 0 0-4-5.6",
  star: "M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z",
  gift: "M4 10h16v11H4zM3 7h18v3H3zM12 7v14M12 7c-1-3-5-4-5-1.5S10 7 12 7zM12 7c1-3 5-4 5-1.5S14 7 12 7z",
  cake: "M4 21h16M5 21v-7h14v7M5 17c2 1 3-1 4.7-1s2.6 2 4.6 2 3-2 4.7-1M12 14V9M12 9c-1 0-1.5-1-.8-2L12 5l.8 2c.7 1 .2 2-.8 2z",
  map: "M12 21s-6-6-6-11a6 6 0 0 1 12 0c0 5-6 11-6 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  clock: "M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18zM12 7v5l3 2",
};
const d = name ? PATHS[name] : undefined;
---
{d && (
  <svg class="s-icon" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d={d} />
  </svg>
)}
