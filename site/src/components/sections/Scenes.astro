---
// Full-width photo panels, each with a text card over it (alternating sides on wide screens).
// The photos scroll more slowly than the cards: parallax "subtle", "medium" (default) or "strong"; false = off.
import { parallaxClass, type Scenes } from "../../lib/sections";
import Paras from "./Paras.astro";
import Heading from "./Heading.astro";
interface Props { s: Scenes }
const { s } = Astro.props;
const parallax = parallaxClass(s.parallax, true);
---
<section class="s-scenes-wrap" id={s.id}>
  {(s.title || s.eyebrow || s.intro) && (
    <div class:list={["s-section", "s-scenes-head", `tone-${s.tone ?? "light"}`]}>
      <div class="wrap">
        {(s.title || s.eyebrow) && <Heading eyebrow={s.eyebrow} title={s.title} accent={s.accent} center />}
        {s.intro && <Paras class="s-intro s-center" text={s.intro} />}
      </div>
    </div>
  )}
  <ul class="s-scenes">
    {s.items.map((it) => (
      <li class:list={["s-scene", parallax]}>
        <img class:list={["s-scene-img", parallax && "s-parallax-img"]} src={it.image.src} alt={it.image.alt ?? ""} loading="lazy" decoding="async" />
        <div class="wrap s-scene-inner">
          <div class="s-scene-card">
            {it.eyebrow && <p class="s-eyebrow">{it.eyebrow}</p>}
            <h3>{it.title}</h3>
            {it.text && <Paras text={it.text} />}
            {it.href && <a class="s-scene-link" href={it.href}>{it.linkLabel || "Learn more"} →</a>}
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>
