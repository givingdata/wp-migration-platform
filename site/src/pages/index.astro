---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import Image from "../components/Image.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import { upcoming, latest, urlFor, formatRange, excerpt, getFrontPage, fixContentLinks, TYPES } from "../lib/content";
import { SITE } from "../lib/site";
import { pageSections, sectionsDescription } from "../lib/sections";
import Sections from "../components/sections/Sections.astro";

// A site migrated with a static WordPress homepage keeps that page as its homepage.
const frontPage = getFrontPage();

// Galleries lead with their current exhibition; otherwise a row of cards per content type
// marked "homepage": true in design-specs (news, upcoming events, …).
const exhibitions = upcoming("exhibition");
const featured = exhibitions[0];
const rows = Object.values(TYPES)
  .filter((t) => t.listing && (t.homepage || t.key === "exhibition"))
  .map((t) => {
    const listing = t.listing as { path: string; title: string; upcoming?: boolean; currentLabel?: string };
    const items = t.key === "exhibition" ? exhibitions.slice(1, 4) : latest(t.key, 6);
    const title = listing.upcoming ? `${listing.currentLabel ?? "Upcoming"} ${listing.title.toLowerCase()}` : listing.title;
    return { key: t.key, title: t.key === "post" ? "Latest news" : title, href: `/${listing.path}/`, all: `All ${listing.title.toLowerCase()}`, items };
  })
  .filter((r) => r.items.length);
// sections.json can build the homepage from sections instead (optionally with the migrated content).
const built = pageSections("/");
const firstIsHero = built?.sections[0]?.type === "hero";
---

<BaseLayout seo={built?.seo || frontPage?.seo} description={(built && sectionsDescription(built.sections)) || (frontPage ? excerpt(frontPage) || SITE.tagline : SITE.tagline)} sectioned={!!built}>
  <AnnouncementBanner />
  {built ? (
    <>
      {!firstIsHero && <h1 class="visually-hidden">{SITE.name}</h1>}
      {built.content === "before" && frontPage && <div class="wrap narrow section"><div class="prose" set:html={fixContentLinks(frontPage.content || "")} /></div>}
      <Sections sections={built.sections} />
      {built.content === "after" && frontPage && <div class="wrap narrow section"><div class="prose" set:html={fixContentLinks(frontPage.content || "")} /></div>}
    </>
  ) : frontPage ? (
    <article class="entry entry-page entry-home">
      <div class="wrap narrow">
        <h1 class="visually-hidden">{SITE.name}</h1>
        <div class="prose" set:html={fixContentLinks(frontPage.content || "")} />
      </div>
    </article>
  ) : featured ? (
    <section class="feature" aria-labelledby="featured-title">
      {featured.image && (
        <Image src={featured.image} alt={featured.imageAlt || ""} type="exhibition" variants={featured.imageVariants} priority sizes="100vw" />
      )}
      <div class="wrap feature-text">
        <p class="eyebrow">Now showing</p>
        <h1 id="featured-title"><a href={urlFor(featured)}>{featured.title}</a></h1>
        <p class="meta">{formatRange(featured.date, featured.endDate)}</p>
        <p>{excerpt(featured, 220)}</p>
      </div>
    </section>
  ) : (
    <section class="intro wrap">
      <h1>{SITE.name}</h1>
      <p class="lede">{SITE.tagline}</p>
    </section>
  )}

  {!built && !frontPage && rows.map((row) => (
    <section class="wrap section" aria-labelledby={`${row.key}-h`}>
      <div class="section-head"><h2 id={`${row.key}-h`}>{row.title}</h2><a href={row.href}>{row.all}</a></div>
      <div class="grid">{row.items.map((e) => <Card entry={e} />)}</div>
    </section>
  ))}
</BaseLayout>
