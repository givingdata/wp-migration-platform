{
  "version": 1,
  "site": "thecinderellaproject.com",
  "breakpoints": [300, 600, 800, 1200],
  "image": {
    "formats": ["webp", "jpeg"],
    "quality": 82,
    "maxUploadBytes": 10485760,
    "acceptedMimeTypes": ["image/jpeg", "image/png", "image/webp"]
  },
  "contentTypes": {
    "exhibition": {
      "aspectRatio": "1.5:1",
      "minWidth": 300,
      "maxWidth": 1200,
      "crop": "center",
      "fields": ["title", "description", "date", "endDate", "location", "image"]
    },
    "event": {
      "aspectRatio": "1:1",
      "minWidth": 300,
      "maxWidth": 1200,
      "crop": "center",
      "fields": ["title", "description", "date", "time", "location", "image"]
    },
    "post": {
      "aspectRatio": "16:9",
      "minWidth": 300,
      "maxWidth": 1200,
      "crop": "center",
      "fields": ["title", "description", "date", "author", "image"]
    }
  }
}
