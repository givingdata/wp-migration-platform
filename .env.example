# Copy to .env and fill in. Never commit .env.

# --- Cloudflare R2 (media storage) — used by wordpress_export.py ---
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for rewritten image links (custom domain or https://pub-xxxx.r2.dev).
# If empty, falls back to https://<bucket>.<account>.r2.cloudflarestorage.com (not publicly readable).
R2_PUBLIC_URL=

# --- Cloudflare account (deploy script / wrangler) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
